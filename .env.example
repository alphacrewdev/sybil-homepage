# Analytics (build-time). Set at most ONE of these, and only for the production build.
# Both unset: no cookie card, no Google code. Preview builds never load analytics.
# Either one: a cookie card asks first; nothing loads from Google until the visitor clicks Accept.

# Google Tag Manager container (the PM's container, which already carries the GA4 tag G-J8BGPNBPW3).
# When this is set, PUBLIC_GA_MEASUREMENT_ID is ignored, so visits are never counted twice.
# See docs/GTM-ACTIVATION-CHECKLIST.md.
PUBLIC_GTM_CONTAINER_ID=

# Direct GA4 (page views only, sanitized). Used only when PUBLIC_GTM_CONTAINER_ID is unset.
# See docs/GA4-ACTIVATION-CHECKLIST.md.
PUBLIC_GA_MEASUREMENT_ID=
