---
// Technical support, at the same slug as the previous site so links from the
// platform keep working. Closes with the learner banner, not a sales one.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import Faq from "../components/page/Faq.astro";
import { footer, links } from "../content/homepage";

const include = [
  "The email used for your account",
  "The course and lesson title, if relevant",
  "What happened, and any error message",
  "Your browser and device",
];

const help = [
  { q: "I can’t sign in", a: "Use the sign-in or account recovery options on the platform. Contact us if you still can’t access your account." },
  { q: "My course isn’t showing", a: "Check that you’re using the email associated with your purchase or program invitation, then contact us with the course name." },
  { q: "A lesson won’t play", a: "Refresh the page and check your connection. If the issue continues, send us the lesson title, browser, and any error message." },
];
---

<BaseLayout promo="learner" title="Technical Support" description="Get help signing in, accessing a course, or playing a lesson on Sybil Digital Learning.">
  <PageHero
    eyebrow="Technical support"
    title="Get help with your course or account."
    intro="Having trouble signing in, accessing a course, or playing a lesson? Email us so we can help."
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`mailto:${footer.contactEmail}?subject=${encodeURIComponent("Technical support")}`} class="btn btn-primary">Email support</a>
      <a href={links.myCourses} class="btn btn-ghost">My courses</a>
    </div>
  </PageHero>

  <div class="wrap">
    <section class="sub-section" aria-labelledby="h-include">
      <h2 class="section-title" id="h-include">What to include</h2>
      <ul class="ticks mt-8 max-w-2xl">
        {include.map((i) => <li>{i}</li>)}
        <li>An optional screenshot, with personal details removed</li>
      </ul>
      <p class="note mt-8">Please don’t send passwords, payment card details, or patient information.</p>
    </section>

    <section class="sub-section mb-16">
      <Faq heading="Common problems" items={help} />
    </section>
  </div>
</BaseLayout>

<style>
  .note { display: inline-block; padding: 0.6rem 0.9rem; border-left: 2px solid var(--mark); background: var(--surface); color: var(--text-muted); font-size: 0.95rem; }
</style>
