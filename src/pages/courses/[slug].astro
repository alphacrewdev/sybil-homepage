---
// One template for the eight subject courses. Content: src/content/courses.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureCards from "../../components/page/FeatureCards.astro";
import PageHero from "../../components/page/PageHero.astro";
import EnrollPanel from "../../components/page/EnrollPanel.astro";
import Faq from "../../components/page/Faq.astro";
import { courseList, productHref, type Course } from "../../content/courses";
import { instructors, courseCredit } from "../../content/team";
import { links, site } from "../../content/homepage";
import { withBase } from "../../lib/base";
import { existsSync } from "node:fs";
import { join } from "node:path";

export function getStaticPaths() {
  return courseList.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

interface Props {
  course: Course;
}
const { course } = Astro.props;
const team = course.instructors.map((id) => instructors[id]);
const hasPhoto = (p?: string) => !!p && existsSync(join(process.cwd(), "public", p));

const experience = [
  { title: "Study on your schedule", body: "Short lessons and visual explanations help you work through the physics.", art: "schedule" },
  { title: "Check your understanding", body: "Lesson quizzes and answer explanations help you decide what to revisit.", art: "quiz" },
  { title: "Continue where you stopped", body: "Resume videos and revisit completed lessons during your access period.", art: "resume" },
];

const faq = [
  { q: "Does this include live teaching?", a: "Live teaching depends on your access arrangement. Check the enrollment details or contact us before purchasing." },
  { q: "Does Sybil offer CME credit?", a: "Sybil does not currently offer CME credit." },
  { q: "Can my program arrange access?", a: "Yes. Schedule a consult to discuss coursework and live teaching for your residency program." },
];

const description = `${course.summary} On-demand radiology physics education for residents.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Course",
      name: course.title,
      description: course.hero,
      provider: { "@type": "Organization", name: site.name, sameAs: site.url },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
        { "@type": "ListItem", position: 2, name: "Courses", item: site.url + "/courses/" },
        { "@type": "ListItem", position: 3, name: course.title, item: `${site.url}/courses/${course.slug}/` },
      ],
    },
  ],
};
---

<BaseLayout title={course.title} description={description} jsonLd={jsonLd} promo="product" promoProduct={course}>
  <PageHero
    title={course.title}
    eyebrow="Course"
    intro={course.hero}
    crumbs={[{ label: "Courses", href: links.courses }, { label: course.title }]}
  >
    <p class="mt-5 text-[0.95rem] text-[var(--text-muted)]">
      Designed for radiology residents; also relevant to other medical professionals reviewing imaging physics.
    </p>
    <div class="cover mt-8">
      <img src={course.image} alt="" width="876" height="608" />
    </div>
    <EnrollPanel product={course} slot="aside" />
  </PageHero>

  <div class="wrap">
    <section class="sub-section" aria-labelledby="h-learn">
      <h2 class="section-title" id="h-learn">What you’ll learn</h2>
      <ul class="ticks mt-8 max-w-3xl">
        {course.outcomes.map((o) => <li>{o}</li>)}
      </ul>

    </section>

    <section class="sub-section" aria-labelledby="h-topics">
      <div class="topics-head">
        <h2 class="section-title" id="h-topics">Topics covered</h2>
        <p class="topics-meta">
          <span class="tag-mono">{course.topics.length} topic areas</span>
          Lessons are short videos, typically 10–15 minutes each.
        </p>
      </div>
      <ol class="topics mt-10" role="list">
        {course.topics.map((t, i) => (
          <li class="topic">
            <span class="topic-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <p class="topic-text">{t}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sub-section" aria-labelledby="h-exp">
      <h2 class="sr-only" id="h-exp">How you’ll study</h2>
      <FeatureCards items={experience} />
    </section>

    <section class="sub-section" aria-labelledby="h-team">
      <h2 class="section-title" id="h-team">{team.length > 1 ? "Instructors" : "Instructor"}</h2>
      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
        {team.map((t) => (
          <div class="flex items-start gap-5">
            {hasPhoto(t.photo) && <img src={withBase(t.photo!)} alt={`Portrait of ${t.name}`} class="avatar" width="72" height="96" loading="lazy" />}
            <div>
              <h3 class="h3">{t.name}</h3>
              <p class="body-muted">{courseCredit[t.id]}</p>
            </div>
          </div>
        ))}
      </div>
      <a href={links.instructors} class="link-accent mt-8">Meet our instructors</a>
    </section>

    <section class="sub-section">
      <Faq heading="Access questions" items={faq} />
    </section>
  </div>

</BaseLayout>

<style>
  .cover { aspect-ratio: 16 / 9; overflow: hidden; background: #04070c; max-width: 40rem; }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .avatar { width: 72px; height: 96px; object-fit: cover; flex: none; }

  .topics-head { display: grid; gap: 0.75rem; }
  @media (min-width: 768px) {
    .topics-head { grid-template-columns: 1fr auto; align-items: end; gap: 2rem; }
  }
  .topics-meta { margin: 0; max-width: 22rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }
  .topics-meta .tag-mono { display: block; margin-bottom: 0.35rem; color: var(--accent); text-transform: uppercase; }

  .topics { list-style: none; margin-inline: 0; margin-bottom: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .topics { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .topics { grid-template-columns: repeat(3, 1fr); } }

  .topic {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.4rem 1.4rem 1.6rem;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.2s ease;
  }
  .topic::before {
    content: "";
    position: absolute;
    left: -1px;
    top: -1px;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    transition: width 0.25s ease;
  }
  .topic:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .topic:hover::before { width: calc(100% + 2px); }
  .topic-n { font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.06em; color: var(--accent); }
  .topic-text { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; line-height: 1.45; color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .topic, .topic::before { transition: none; }
  }
</style>
