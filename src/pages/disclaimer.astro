---
// Same slug as the previous site so platform links keep working.
// Wording is the proposed draft from the Nov 1, 2026 brief, pending owner
// review (see the handoff report); it makes no ABR endorsement claim.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/base";
---

<BaseLayout title="Educational scope" description="What Sybil Digital Learning courses cover, and what they do not.">
  <PageHero title="Educational scope." />
  <section class="wrap prose">
    <p>
      Sybil Digital Learning provides radiology physics education and review of the physics content on the ABR Core Exam.
      The courses do not cover clinical exam content and do not replace professional judgment, clinical training, or
      applicable institutional procedures. Sybil does not currently offer CME credit. Participation or completion does not
      guarantee an examination result.
    </p>
    <p>
      Questions? <a href={withBase("/contact/")}>Contact us</a>, or read our
      <a href={withBase("/terms-conditions/")}>Terms &amp; Conditions</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .prose { max-width: 46rem; padding-bottom: clamp(4rem, 9vw, 7rem); color: var(--text-muted); font-size: 1.02rem; line-height: 1.75; }
  .prose p { margin: 0 0 1rem; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
