---
// Built as 404.html; GitHub Pages (and most static hosts) serve it with a
// real 404 status for unknown paths.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import { links } from "../content/homepage";
import { withBase } from "../lib/base";
---

<BaseLayout title="Page not found" noindex>
  <PageHero
    title="We couldn’t find that page."
    intro="The link may have changed. Browse the courses or return to the homepage to find your next step."
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={links.courses} class="btn btn-primary">Browse courses</a>
      <a href={withBase("/")} class="btn btn-ghost">Back to home</a>
    </div>
    <p class="mt-8 text-[0.95rem] text-[var(--text-muted)]">
      Having trouble with your account? <a class="text-link" href={links.support}>Contact support</a>
    </p>
  </PageHero>
  <div class="h-24"></div>
</BaseLayout>
