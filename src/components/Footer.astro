---
import { site, footer } from "../content/homepage";
import { withBase } from "../lib/base";
---

<footer class="sitefoot rule-gradient">
  <div class="wrap">
    <div class="top">
      <div class="brandblock">
        <img class="flogo flogo-light" src={withBase("/brand/sybil-logo-color.png")} alt={site.name} width="838" height="283" />
        <img class="flogo flogo-dark" src={withBase("/brand/sybil-logo-white.png")} alt={site.name} width="838" height="283" />
        <p class="fdesc">{footer.blurb}</p>
        <a class="fmail" href={`mailto:${footer.contactEmail}`}>{footer.contactEmail}</a>
      </div>

      <div class="cols">
        {footer.columns.map((col) => (
          <nav class="col" aria-label={col.title}>
            <p class="coltitle">{col.title}</p>
            {col.links.map((link) => (
              <a class="collink" href={link.href}>{link.label}</a>
            ))}
          </nav>
        ))}
      </div>
    </div>

    <a class="legacy" href={footer.legacyPlatform.href}>{footer.legacyPlatform.label}</a>

    <div class="legalbar">
      <span>© <span id="fyear">2026</span> {site.name}. All rights reserved.</span>
      <nav class="legallinks" aria-label="Legal">
        {footer.legal.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <span>Developed by <a href="https://alphacrewstudio.com" rel="noopener">AlphaCrew Studio</a></span>
    </div>
  </div>
</footer>

<style>
  .sitefoot {
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 3.25rem 0 3rem;
  }

  .top {
    display: grid;
    gap: 2.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .top { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr); gap: 4rem; }
  }

  .flogo { height: 2.1rem; width: auto; display: block; }
  .flogo-dark { display: none; }
  :root.dark .flogo-light { display: none; }
  :root.dark .flogo-dark { display: block; }

  .fdesc { margin: 1.1rem 0 0; max-width: 52ch; line-height: 1.7; }

  .fmail {
    display: inline-block;
    margin-top: 1rem;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.18s ease;
  }

  .fmail:hover { color: var(--accent); }

  .cols {
    display: grid;
    gap: 1.6rem 1.4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    line-height: 1.75;
  }

  .col { display: flex; flex-direction: column; }

  .coltitle {
    margin: 0 0 0.6rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .collink { color: var(--text-muted); transition: color 0.18s ease; }
  .collink:hover { color: var(--accent); }

  /* Deliberately quiet: a handful of legacy students still need it, and Karen
     doesn't want it competing with the real login. */
  .legacy {
    display: inline-block;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    opacity: 0.75;
    transition: opacity 0.18s ease, color 0.18s ease;
  }

  .legacy:hover { opacity: 1; color: var(--accent); }

  .legalbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    margin-top: 1.6rem;
    padding-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .legallinks { display: flex; gap: 1.2rem; }
  .legalbar a { color: inherit; transition: color 0.18s ease; }
  .legalbar a:hover { color: var(--accent); }
</style>

<script>
  const year = document.getElementById("fyear");
  if (year) year.textContent = String(new Date().getFullYear());
</script>
