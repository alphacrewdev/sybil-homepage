---
import CourseVignette from "./CourseVignette.astro";
import CourseModal from "./CourseModal.astro";
import { courses } from "../content/homepage";
import { courseList } from "../content/courses";
---

<section class="wrap section" id="courses">
  <div class="rv max-w-2xl">
    <h2 class="section-title">{courses.heading}</h2>
    <p class="section-lede">{courses.intro}</p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {courseList.map((course, i) => (
      <article class:list={["course bracket-frame lift rv", i > 0 && `rv-d${Math.min(i, 5)}`]} data-open={course.slug} tabindex="-1">
        <span class="bf-corner" aria-hidden="true"></span>
        <span class="bf-corner" aria-hidden="true"></span>
        <div class="relative flex h-full flex-col bg-[var(--surface)]">
          <div class:list={["media", course.image && "has-photo"]}>
            {course.image
              ? <img src={course.image} alt="" loading="lazy" width="438" height="304" />
              : <CourseVignette kind={course.slug} light />}
            <span class="tag-mono media-tag">{course.tag.toUpperCase()}</span>
          </div>
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <h3 class="text-[15.5px] font-semibold">{course.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{course.blurb}</p>
            </div>
            <div class="mt-6 flex items-center justify-between gap-3">
              <button type="button" class="link-accent open-btn" data-open={course.slug} aria-haspopup="dialog" aria-controls={`cm-${course.slug}`}>Learn more</button>
              {(course.rating || course.students) && (
                <span class="tag-mono whitespace-nowrap">
                  {course.rating && <span style="color: var(--mark);">★</span>} {course.rating}{course.students && ` · ${course.students} students`}
                </span>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="rv mt-10">
    <a href={courses.cta.href} class="btn btn-ghost">{courses.cta.label}</a>
  </div>

  {courseList.map((course) => <CourseModal course={course} />)}
</section>

<style>
  .course { cursor: pointer; }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .media.has-photo { background: #04070c; }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: transform 0.7s cubic-bezier(0.22, 0.9, 0.28, 1), filter 0.7s ease;
    filter: saturate(0.85) contrast(1.05);
  }

  /* Navy wash for photographs only; a light drawn card must stay light. */
  .media.has-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(2, 43, 98, 0.35), transparent 45%),
      linear-gradient(to top, rgba(3, 20, 43, 0.55), transparent 55%);
    transition: opacity 0.5s ease;
  }

  .course:hover .media img { transform: scale(1.08); filter: saturate(1) contrast(1.05); }
  .course:hover .media.has-photo::after { opacity: 0.7; }

  .media-tag { position: absolute; top: 0.75rem; left: 0.85rem; z-index: 1; color: #e6eef3; }
  .media:not(.has-photo) .media-tag { color: var(--text-muted); }
  :root.dark .media:not(.has-photo) .media-tag { color: #e6eef3; }

  .open-btn { background: none; padding: 0 0 1px; cursor: pointer; font: inherit; font-size: 0.9rem; font-weight: 500; }
</style>

<script>
  const root = document.documentElement;
  let openDialog: HTMLDialogElement | null = null;

  function open(slug: string) {
    const dialog = document.getElementById(`cm-${slug}`) as HTMLDialogElement | null;
    if (!dialog) return;
    dialog.showModal();
    openDialog = dialog;
    root.style.overflow = "hidden";
  }

  function close(dialog: HTMLDialogElement) {
    dialog.close();
  }

  // Whole card opens the course; the "Learn more" button is the accessible control.
  document.querySelectorAll<HTMLElement>("[data-open]").forEach((el) => {
    el.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      e.stopPropagation();
      open(el.dataset.open!);
    });
  });

  document.querySelectorAll<HTMLDialogElement>("dialog.cm").forEach((dialog) => {
    dialog.querySelector("[data-close]")?.addEventListener("click", () => close(dialog));
    // Click on the backdrop (outside the panel) closes.
    dialog.addEventListener("click", (e) => { if (e.target === dialog) close(dialog); });
    dialog.addEventListener("close", () => {
      if (openDialog === dialog) openDialog = null;
      root.style.overflow = "";
    });
  });
</script>
