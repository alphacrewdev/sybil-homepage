---
// "Watch a sample lesson" is Karen's chosen secondary action. The section
// renders only once `sample.videoUrl` is set; never an empty player.
import BracketFrame from "./BracketFrame.astro";
import { sample } from "../content/homepage";
---

{sample.videoUrl && (
<section class="wrap section" id="sample">
  <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-14">
    <div class="rv min-w-0">
      <span class="eyebrow">{sample.eyebrow}</span>
      <h2 class="section-title">{sample.heading}</h2>
      <p class="section-lede">{sample.body}</p>
      <a href={sample.cta.href} class="btn btn-primary mt-8">{sample.cta.label}</a>
    </div>

    <div class="rv rv-d1 min-w-0">
      <BracketFrame>
        <div class="player">
          <iframe src={sample.videoUrl} title="Sample lesson" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
      </BracketFrame>
    </div>
  </div>
</section>
)}

<style>
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #04070c;
    overflow: hidden;
  }

  .player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
