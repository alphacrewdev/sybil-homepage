---
// Real reviews carried over from the current site's course pages; Karen has
// confirmed written comments may appear publicly.
import { testimonials } from "../content/homepage";
---

<section class="border-y bg-[var(--surface)]">
  <div class="wrap py-14">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {testimonials.map((t, i) => (
        <figure class:list={["quote bracket-frame rv", i === 1 && "rv-d1"]}>
          <span class="bf-corner" aria-hidden="true"></span>
          <span class="bf-corner" aria-hidden="true"></span>
          <div class="relative bg-[var(--bg)] p-7">
            <div class="flex gap-0.5" aria-label={`${t.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill={s < t.rating ? "var(--mark)" : "none"} stroke="var(--mark)" aria-hidden="true">
                  <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5z"></path>
                </svg>
              ))}
            </div>
            <blockquote class="mt-4">
              <p class="quote-text">“{t.text}”</p>
            </blockquote>
            <figcaption class="tag-mono mt-5">{t.author.toUpperCase()}</figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    font-size: clamp(1.1rem, 1.9vw, 1.35rem);
    text-wrap: balance;
  }
</style>
