---
// Compact hero for secondary pages: eyebrow, H1, short intro, optional actions.
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  breadcrumb?: { label: string; href?: string }[];
}
const { eyebrow, title, lede, breadcrumb } = Astro.props;
---

<section class="wrap pagehero">
  {breadcrumb && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumb.map((c, i) => (
          <li>
            {c.href && i < breadcrumb.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
  )}
  <div class="max-w-3xl">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="section-title">{title}</h1>
    {lede && <p class="section-lede">{lede}</p>}
    <div class="actions"><slot /></div>
  </div>
</section>

<style>
  .pagehero { padding-block: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .actions:not(:empty) { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .crumbs { margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--text-muted); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; list-style: none; margin: 0; padding: 0; }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; opacity: 0.6; }
  .crumbs a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
