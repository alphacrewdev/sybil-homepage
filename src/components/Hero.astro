---
import BracketFrame from "./BracketFrame.astro";
import { hero } from "../content/homepage";
---

<section class="mx-auto max-w-6xl px-5 pb-16 pt-14 md:px-8 md:pb-24 md:pt-20">
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-8">
    <div class="min-w-0">
      <h1 class="max-w-xl text-4xl font-semibold leading-[1.08] tracking-tight md:text-5xl">
        {hero.headline}
      </h1>
      <p class="mt-6 max-w-md text-[15px] leading-relaxed text-[var(--text-muted)]">
        {hero.sub}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href={hero.primaryCta.href}
          class="rounded-full px-6 py-3 text-sm font-medium transition-transform hover:-translate-y-0.5"
          style="background: var(--accent); color: var(--accent-contrast);"
        >
          {hero.primaryCta.label}
        </a>
        <a
          href={hero.secondaryCta.href}
          class="text-sm text-[var(--text-muted)] underline decoration-[var(--border)] underline-offset-4 transition-colors hover:text-[var(--accent)]"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>

    <BracketFrame label={hero.mediaCaption} class="frame-intro min-w-0">
      <div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-[var(--surface)]">
        <!-- Abstract placeholder — swap for real course footage/still, see questionnaire A3 -->
        <svg viewBox="0 0 320 240" class="h-full w-full" role="img" aria-label="Cross-sectional course preview illustration">
          <rect width="320" height="240" fill="var(--surface)"></rect>
          {Array.from({ length: 6 }).map((_, i) => (
            <ellipse
              cx="160"
              cy={70 + i * 22}
              rx={110 - i * 6}
              ry={16 - i * 0.6}
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.2"
              opacity={0.85 - i * 0.11}
            ></ellipse>
          ))}
          <line x1="30" y1="20" x2="30" y2="220" stroke="var(--border)" stroke-width="1"></line>
          <line x1="20" y1="30" x2="40" y2="30" stroke="var(--border)" stroke-width="1"></line>
          <line x1="20" y1="210" x2="40" y2="210" stroke="var(--border)" stroke-width="1"></line>
        </svg>
      </div>
    </BracketFrame>
  </div>
</section>
