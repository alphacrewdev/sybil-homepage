---
import BracketFrame from "./BracketFrame.astro";
import ModalityCycle from "./ModalityCycle.astro";
import { hero } from "../content/homepage";
---

<section class="mx-auto max-w-6xl px-5 pb-16 pt-14 md:px-8 md:pb-24 md:pt-20">
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-8">
    <div class="min-w-0">
      <h1 class="max-w-xl text-4xl font-semibold leading-[1.08] tracking-tight md:text-5xl">
        {hero.headline}
      </h1>
      <p class="mt-6 max-w-md text-[15px] leading-relaxed text-[var(--text-muted)]">
        {hero.sub}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href={hero.primaryCta.href}
          class="rounded-full px-6 py-3 text-sm font-medium transition-transform hover:-translate-y-0.5"
          style="background: var(--accent); color: var(--accent-contrast);"
        >
          {hero.primaryCta.label}
        </a>
        <a
          href={hero.secondaryCta.href}
          class="text-sm text-[var(--text-muted)] underline decoration-[var(--border)] underline-offset-4 transition-colors hover:text-[var(--accent)]"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>

    <div class="min-w-0">
      <BracketFrame class="frame-intro">
        <ModalityCycle />
      </BracketFrame>
      <p class="tag-mono mt-3">{hero.mediaCaption}</p>
    </div>
  </div>
</section>
