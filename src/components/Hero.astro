---
// Hero over a looping background video ("Follow the Signal"). The light
// version has the page colour and a left fade baked in, so the copy needs no
// overlay; dark mode inverts and dims it. Reduced motion shows the poster.
import { hero, sample } from "../content/homepage";
import { withBase } from "../lib/base";

// No sample video yet: point the second button at the learning approach.
const second = sample.videoUrl ? hero.secondaryCta : hero.fallbackCta;
const media = (f: string) => withBase(`/media/${f}`);
---

<section class="hero">
  <video
    class="hero-bg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={media("sybil-hero-bg-poster.webp")}
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={media("sybil-hero-bg-720.webm")} type="video/webm" media="(max-width: 900px)" />
    <source src={media("sybil-hero-bg-720.mp4")} type="video/mp4" media="(max-width: 900px)" />
    <source src={media("sybil-hero-bg-1080.webm")} type="video/webm" />
    <source src={media("sybil-hero-bg-1080.mp4")} type="video/mp4" />
  </video>
  <img class="hero-still" src={media("sybil-hero-bg-poster.webp")} alt="" aria-hidden="true" />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="wrap hero-content">
    <div class="max-w-xl">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="text-4xl font-semibold leading-[1.08] tracking-tight md:text-[3.4rem]">
        {hero.headline}
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-[var(--text-muted)]">
        {hero.sub}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
        <a href={second.href} class="btn btn-ghost hero-ghost">{second.label}</a>
      </div>
      <p class="mt-5 text-sm text-[var(--text-muted)]">
        {hero.programLine.text} <a href={hero.programLine.href} class="link-accent text-sm">{hero.programLine.label}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(34rem, 86svh, 50rem);
    background: #f1f5f7;
  }
  .hero-bg,
  .hero-still {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .hero-still { display: none; }
  .hero-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-content { position: relative; width: 100%; padding-block: 4rem 5rem; }
  .hero-ghost { background: color-mix(in srgb, var(--bg) 70%, transparent); }

  /* Narrow screens: the copy covers the whole frame, so wash the video and
     fade it out behind the text block. */
  @media (max-width: 900px) {
    .hero { align-items: flex-end; min-height: clamp(36rem, 92svh, 46rem); }
    .hero-bg, .hero-still { opacity: 0.9; object-position: 82% center; }
    .hero-shade { background: linear-gradient(180deg, rgba(241, 245, 247, 0) 0%, rgba(241, 245, 247, 0.35) 30%, rgba(241, 245, 247, 0.92) 52%, #f1f5f7 70%); }
    .hero-content { padding-block: 3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg { display: none; }
    .hero-still { display: block; }
  }

  /* Dark theme: invert the light treatment into the navy palette and dim it,
     keeping the left side dark for the copy. */
  :global(.dark) .hero { background: var(--bg); }
  :global(.dark) .hero-bg,
  :global(.dark) .hero-still { filter: invert(1) hue-rotate(180deg) saturate(1.6) brightness(1.15); opacity: 0.55; mix-blend-mode: screen; }
  :global(.dark) .hero-shade { background: linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 30%, transparent 65%); }
  @media (max-width: 900px) {
    :global(.dark) .hero-bg, :global(.dark) .hero-still { opacity: 0.5; }
    :global(.dark) .hero-shade { background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--bg) 40%, transparent) 30%, color-mix(in srgb, var(--bg) 92%, transparent) 52%, var(--bg) 70%); }
  }
</style>
