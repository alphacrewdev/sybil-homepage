---
import BracketFrame from "./BracketFrame.astro";
import ModalityCycle from "./ModalityCycle.astro";
import { hero } from "../content/homepage";
---

<section class="wrap pb-16 pt-12 md:pb-24 md:pt-16">
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-[1.05fr_0.95fr] md:gap-10">
    <div class="min-w-0">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="max-w-xl text-4xl font-semibold leading-[1.08] tracking-tight md:text-[3.1rem]">
        {hero.headline}
      </h1>
      <p class="mt-6 max-w-lg text-[15.5px] leading-relaxed text-[var(--text-muted)]">
        {hero.sub}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
        <a href={hero.secondaryCta.href} class="btn btn-ghost">{hero.secondaryCta.label}</a>
      </div>
    </div>

    <div class="min-w-0">
      <BracketFrame class="frame-intro">
        <ModalityCycle />
      </BracketFrame>
      <p class="tag-mono mt-3">{hero.mediaCaption}</p>
    </div>
  </div>
</section>
