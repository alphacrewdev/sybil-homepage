---
import { outreach } from "../content/homepage";
import { withBase } from "../lib/base";
const stars = Math.round(Number(outreach.averageRating));
---

<section class="border-y bg-[var(--surface)]">
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-6 sm:flex-row sm:gap-10">
      {outreach.partners.map((partner, i) => (
        <div class:list={["rv flex items-center gap-4", i === 1 && "rv-d1"]}>
          <div class="bracket-frame shrink-0">
            <span class="bf-corner" aria-hidden="true"></span>
            <span class="bf-corner" aria-hidden="true"></span>
            <!-- White plate in both themes: the logos are drawn for a light background. -->
            <div class="grid h-16 w-48 place-items-center bg-white px-4">
              <img src={withBase(partner.logo)} alt={partner.name} class="max-h-11 w-auto max-w-full object-contain" loading="lazy" />
            </div>
          </div>
          <p class="max-w-[16rem] text-sm leading-relaxed text-[var(--text-muted)]">{partner.blurb}</p>
        </div>
      ))}
    </div>

    <div class="rv rv-d2 flex flex-col gap-2 md:items-end">
      <div class="flex items-center gap-2">
        <div class="flex" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill={i < stars ? "var(--mark)" : "none"} stroke="var(--mark)">
              <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5z"></path>
            </svg>
          ))}
        </div>
        <p class="tag-mono md:whitespace-nowrap">
          {outreach.averageRating} avg rating · {outreach.students} students
        </p>
      </div>
      <p class="tag-mono md:whitespace-nowrap">{outreach.scope}</p>
    </div>
  </div>
</section>
