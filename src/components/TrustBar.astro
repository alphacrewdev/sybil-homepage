---
import { outreach } from "../content/homepage";
import { withBase } from "../lib/base";
---

<section class="border-y bg-[var(--surface)]">
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-6 sm:flex-row sm:gap-10">
      {outreach.partners.map((partner, i) => (
        <div class:list={["rv flex items-center gap-4", i === 1 && "rv-d1"]}>
          <div class="bracket-frame shrink-0">
            <span class="bf-corner" aria-hidden="true"></span>
            <span class="bf-corner" aria-hidden="true"></span>
            <!-- White plate in both themes: the logos are drawn for a light background. -->
            <div class="grid h-16 w-48 place-items-center bg-white px-4">
              <img src={withBase(partner.logo)} alt={partner.name} class="max-h-11 w-auto max-w-full object-contain" loading="lazy" />
            </div>
          </div>
          <p class="max-w-[16rem] text-xs leading-snug text-[var(--text-muted)]">{partner.blurb}</p>
        </div>
      ))}
    </div>

    <p class="rv rv-d2 tag-mono md:whitespace-nowrap">{outreach.scope}</p>
  </div>
</section>
