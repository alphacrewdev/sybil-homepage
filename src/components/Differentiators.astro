---
import { differentiators } from "../content/homepage";
---

<section class="mx-auto max-w-6xl px-5 py-20 md:px-8">
  <h2 class="max-w-lg text-2xl font-semibold tracking-tight md:text-3xl">
    Most of this material is still taught on a whiteboard.
  </h2>
  <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
    {differentiators.map((item) => (
      <div class="border-t pt-5">
        <h3 class="text-[15px] font-semibold">{item.title}</h3>
        <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-muted)]">{item.body}</p>
      </div>
    ))}
  </div>
</section>
