---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  pending: string[];
}
const { eyebrow, heading, body, pending } = Astro.props;
---

<section class="mx-auto max-w-3xl px-5 py-20 md:px-8 md:py-28">
  <p class="tag-mono">{eyebrow}</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{heading}</h1>
  <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-[var(--text-muted)]">{body}</p>

  <div class="mt-10 border-l-2 pl-5" style="border-color: var(--mark);">
    <p class="text-xs font-medium uppercase tracking-wide" style="color: var(--mark);">Waiting on</p>
    <ul class="mt-2 space-y-1.5 text-sm text-[var(--text-muted)]">
      {pending.map((item) => <li>· {item}</li>)}
    </ul>
  </div>
</section>
