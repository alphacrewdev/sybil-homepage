---
import { modalityPath } from "../content/homepage";
---

<section class="border-y bg-[var(--surface)]">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8">
    <h2 class="max-w-lg text-2xl font-semibold tracking-tight md:text-3xl">
      The order residents actually take it in.
    </h2>
    <p class="mt-3 max-w-md text-sm text-[var(--text-muted)]">
      Coursework follows the rotation, not a semester — residents move through modalities as their program schedules them.
    </p>

    <ol class="mt-12 flex flex-col md:flex-row md:items-stretch">
      {modalityPath.map((step, i) => (
        <li class="relative flex-1 border-t py-5 md:border-l md:border-t-0 md:py-0 md:pl-6" style="border-color: var(--border);">
          <span class="tag-mono">{String(step.order).padStart(2, "0")}</span>
          <p class="mt-1.5 text-[15px] font-medium">{step.modality}</p>
          <p class="mt-1 text-xs text-[var(--text-muted)]">
            {step.status === "available" ? "Course available" : "In production"}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
