---
import BracketFrame from "./BracketFrame.astro";
import { team } from "../content/homepage";
import { withBase } from "../lib/base";
---

<section class="wrap section">
  <div class="grid grid-cols-1 gap-10 md:grid-cols-[260px_1fr] md:items-center md:gap-14">
    <BracketFrame class="rv w-fit">
      <!-- TODO(karen): replace with headshot — see questionnaire C1 -->
      <div class="portrait" role="img" aria-label={team.photoAlt}>
        <img src={withBase("/brand/sybil-mark-color.png")} alt="" class="mark" />
        <span class="tag-mono">PORTRAIT PENDING</span>
      </div>
    </BracketFrame>

    <div class="rv rv-d1 min-w-0">
      <span class="eyebrow">{team.eyebrow}</span>
      <h2 class="section-title">{team.heading}</h2>
      <p class="section-lede">{team.bio}</p>
      <ul class="mt-6 flex flex-wrap gap-2 p-0" role="list">
        {team.credentials.map((c) => (
          <li class="tag-mono border px-2.5 py-1" style="border-color: var(--border);">{c}</li>
        ))}
      </ul>
      <a href={team.link.href} class="link-accent mt-7">{team.link.label}</a>
    </div>
  </div>
</section>

<style>
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    width: 240px;
    aspect-ratio: 3 / 4;
    background: var(--surface);
    overflow: hidden;
  }

  .mark {
    position: absolute;
    width: 150%;
    max-width: none;
    right: -40%;
    bottom: -25%;
    opacity: 0.07;
    pointer-events: none;
  }

  :root.dark .mark { filter: brightness(2.2); }
</style>
