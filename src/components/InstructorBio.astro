---
import BracketFrame from "./BracketFrame.astro";
import { instructor } from "../content/homepage";
---

<section class="border-t bg-[var(--surface)]">
  <div class="mx-auto grid grid-cols-1 max-w-6xl gap-8 px-5 py-20 md:grid-cols-[220px_1fr] md:items-center md:gap-12 md:px-8">
    <BracketFrame class="w-fit">
      <div class="grid h-[220px] w-[180px] place-items-center bg-[var(--bg)]" aria-hidden="true">
        <!-- TODO(karen): replace with headshot — see questionnaire C1 -->
        <span class="tag-mono">PHOTO PENDING</span>
      </div>
    </BracketFrame>
    <div>
      <p class="font-[family-name:var(--font-display)] text-xl font-semibold">{instructor.name}</p>
      <p class="mt-3 max-w-lg text-sm leading-relaxed text-[var(--text-muted)]">{instructor.bio}</p>
      <a
        href="/about"
        class="mt-5 inline-block text-sm font-medium underline decoration-[var(--border)] underline-offset-4 hover:text-[var(--accent)]"
      >
        Full bio and credentials
      </a>
    </div>
  </div>
</section>
