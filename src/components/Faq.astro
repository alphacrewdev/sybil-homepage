---
// Accessible accordion on native <details>: keyboard and screen-reader
// support come free, and every answer stays readable without JavaScript.
interface Props {
  items: { q: string; a: string }[];
  label?: string;
}
const { items, label = "Frequently asked questions" } = Astro.props;
---

<div class="faq" role="group" aria-label={label}>
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--border); }
  details { border-bottom: 1px solid var(--border); }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--text);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    flex: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  details[open] summary::after { transform: rotate(45deg); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  p { margin: 0 0 1.2rem; padding: 0 0.25rem; max-width: 46rem; color: var(--text-muted); line-height: 1.7; }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
