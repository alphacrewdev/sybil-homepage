---
// Small UI vignettes for the study-tools cards. Drawn in the site's
// diagrammatic register: currentColor for structure, the accent for the
// one thing each tool does.
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<div class="vig" aria-hidden="true">
  {kind === "quiz" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="22" y="14" width="156" height="92" rx="7"></rect>
      <rect x="36" y="27" width="92" height="6" rx="3" fill="currentColor" opacity="0.45" stroke="none"></rect>
      <circle cx="42" cy="50" r="5.5"></circle>
      <rect x="54" y="47" width="70" height="6" rx="3" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <circle cx="42" cy="68" r="5.5" fill="var(--accent)" stroke="var(--accent)"></circle>
      <path d="M39.3 68l2 2 3.6-4" stroke="var(--accent-contrast)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      <rect x="54" y="65" width="84" height="6" rx="3" fill="var(--accent)" opacity="0.55" stroke="none"></rect>
      <circle cx="42" cy="86" r="5.5"></circle>
      <path d="M39 83l6 6" stroke-linecap="round" opacity="0.7"></path>
      <rect x="54" y="83" width="58" height="6" rx="3" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <rect x="132" y="92" width="34" height="8" rx="4" fill="var(--accent)" stroke="none"></rect>
    </svg>
  )}

  {kind === "bank" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="54" y="38" width="112" height="70" rx="7" opacity="0.35"></rect>
      <rect x="44" y="29" width="112" height="70" rx="7" opacity="0.6"></rect>
      <rect x="34" y="20" width="112" height="70" rx="7" fill="var(--surface)"></rect>
      <text x="46" y="44" font-family="var(--font-mono)" font-size="9" fill="currentColor" stroke="none" letter-spacing="0.5">Q 128 / 400</text>
      <rect x="46" y="54" width="82" height="5" rx="2.5" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <rect x="46" y="64" width="62" height="5" rx="2.5" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <rect x="46" y="78" width="88" height="4" rx="2" fill="currentColor" opacity="0.25" stroke="none"></rect>
      <rect x="46" y="78" width="28" height="4" rx="2" fill="var(--accent)" stroke="none"></rect>
    </svg>
  )}

  {kind === "search" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="24" y="20" width="152" height="22" rx="11"></rect>
      <circle cx="38" cy="31" r="4.5"></circle>
      <path d="M41.5 34.5l3 3" stroke-linecap="round"></path>
      <rect x="54" y="28" width="30" height="6" rx="3" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <rect x="88" y="26" width="34" height="10" rx="3" fill="var(--accent)" opacity="0.35" stroke="none"></rect>
      <rect x="92" y="28" width="26" height="6" rx="3" fill="var(--accent)" stroke="none"></rect>
      <path d="M24 84h152" stroke-width="2" opacity="0.5"></path>
      <path d="M24 78v12M62 79v10M100 79v10M138 79v10M176 78v12" stroke-linecap="round" opacity="0.6"></path>
      <rect x="100" y="80" width="38" height="8" rx="4" fill="var(--accent)" stroke="none"></rect>
      <path d="M119 72l-4-6h8z" fill="var(--accent)" stroke="none"></path>
    </svg>
  )}

  {kind === "notes" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M24 48h152" stroke-width="2" opacity="0.5"></path>
      <path d="M24 44v8M176 44v8" stroke-linecap="round" opacity="0.6"></path>
      <rect x="24" y="46" width="70" height="4" rx="2" fill="currentColor" opacity="0.35" stroke="none"></rect>
      <circle cx="94" cy="48" r="4" fill="var(--accent)" stroke="none"></circle>
      <path d="M94 42V22h13l-4 5 4 5H94" fill="var(--accent)" stroke="none"></path>
      <rect x="86" y="62" width="88" height="42" rx="6" fill="var(--surface)"></rect>
      <path d="M94 55l6 7h-12z" fill="var(--surface)" stroke="currentColor"></path>
      <rect x="96" y="72" width="64" height="5" rx="2.5" fill="currentColor" opacity="0.4" stroke="none"></rect>
      <rect x="96" y="82" width="46" height="5" rx="2.5" fill="currentColor" opacity="0.4" stroke="none"></rect>
      <rect x="96" y="92" width="30" height="5" rx="2.5" fill="var(--accent)" opacity="0.6" stroke="none"></rect>
    </svg>
  )}

  {kind === "resume" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <text x="24" y="40" font-family="var(--font-mono)" font-size="9" fill="currentColor" stroke="none" letter-spacing="0.5">COURSE PROGRESS</text>
      <text x="153" y="40" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" stroke="none">64%</text>
      <rect x="24" y="52" width="152" height="8" rx="4" fill="currentColor" opacity="0.22" stroke="none"></rect>
      <rect x="24" y="52" width="97" height="8" rx="4" fill="var(--accent)" stroke="none" class="vig-fill"></rect>
      <circle cx="121" cy="56" r="11" fill="var(--accent)" stroke="var(--surface)" stroke-width="2.5"></circle>
      <path d="M118.2 51.5v9l7-4.5z" fill="var(--accent-contrast)" stroke="none"></path>
      <rect x="24" y="76" width="44" height="18" rx="9"></rect>
      <rect x="32" y="83" width="28" height="4" rx="2" fill="currentColor" opacity="0.5" stroke="none"></rect>
      <rect x="76" y="76" width="44" height="18" rx="9" opacity="0.5"></rect>
      <rect x="84" y="83" width="28" height="4" rx="2" fill="currentColor" opacity="0.3" stroke="none"></rect>
    </svg>
  )}

  {kind === "dicom" && (
    <svg viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="100" cy="62" r="46" opacity="0.6"></circle>
      <ellipse cx="100" cy="66" rx="27" ry="21" fill="currentColor" opacity="0.28" stroke="none"></ellipse>
      <ellipse cx="106" cy="62" rx="10" ry="8" fill="currentColor" opacity="0.35" stroke="none"></ellipse>
      <path d="M78 62h44" stroke="var(--accent)" stroke-width="1.8"></path>
      <path d="M78 57v10M122 57v10" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"></path>
      <text x="82" y="50" font-family="var(--font-mono)" font-size="9" fill="var(--accent)" stroke="none">24.3 mm</text>
      <path d="M14 22v-8h8M178 14h8v8M14 100v8h8M186 100v8h-8" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  )}
</div>

<style>
  .vig {
    aspect-ratio: 5 / 3;
    width: 100%;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 70%, var(--bg));
    border-bottom: 1px solid var(--border);
    display: grid;
    place-items: center;
    padding: 0.75rem 1rem;
  }

  .vig svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .vig-fill { transition: width 0.6s cubic-bezier(0.22, 0.9, 0.28, 1); }
  :global(.tool:hover) .vig-fill { width: 118px; }
</style>
