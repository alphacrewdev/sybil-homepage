---
// Small schematic infographics for three-up feature cards. Line drawings in
// the site's accent and muted tones, so they follow light and dark themes.
// Illustrative only: no real data, counts, or durations beyond those the
// pages already state.
export type ArtKey =
  | "schedule" | "quiz" | "resume"
  | "focus" | "complement" | "access"
  | "subjects" | "connect" | "week"
  | "progress" | "coordinate";

interface Props {
  art: ArtKey;
}
const { art } = Astro.props;
const subjects = ["XR", "MG", "FL", "CT", "NM", "RB", "US", "MR"];
---

<svg class="fa" viewBox="0 0 240 120" role="presentation" aria-hidden="true">
  {art === "schedule" && (
    <g>
      <circle class="a" cx="30" cy="44" r="16" />
      <path class="a" d="M30 34v10l7 5" />
      <text class="t" x="56" y="40">LESSON</text>
      <text class="t tm" x="56" y="54">10–15 MIN</text>
      <rect class="m" x="14" y="80" width="212" height="12" rx="6" />
      <rect class="af" x="14" y="80" width="40" height="12" rx="6" />
      <rect class="af o6" x="58" y="80" width="34" height="12" rx="6" />
      <rect class="af o4" x="96" y="80" width="44" height="12" rx="6" />
      <rect class="mf" x="144" y="80" width="38" height="12" rx="6" />
      <rect class="mf" x="186" y="80" width="40" height="12" rx="6" />
    </g>
  )}

  {art === "quiz" && (
    <g>
      <rect class="card" x="20" y="10" width="200" height="100" rx="4" />
      <rect class="mf" x="34" y="22" width="120" height="6" rx="3" />
      <circle class="m" cx="40" cy="44" r="5" /><rect class="mf" x="52" y="41" width="70" height="6" rx="3" />
      <circle class="af" cx="40" cy="60" r="5" /><rect class="af o4" x="52" y="57" width="90" height="6" rx="3" />
      <path class="ck" d="M37.5 60l2 2 3.5-4" />
      <circle class="m" cx="40" cy="76" r="5" /><rect class="mf" x="52" y="73" width="60" height="6" rx="3" />
      <rect class="kf" x="34" y="88" width="3" height="14" />
      <rect class="mf" x="42" y="89" width="150" height="4" rx="2" />
      <rect class="mf" x="42" y="97" width="110" height="4" rx="2" />
    </g>
  )}

  {art === "resume" && (
    <g>
      <rect class="card" x="14" y="12" width="128" height="74" rx="4" />
      <path class="af" d="M70 36l18 13-18 13z" />
      <rect class="m" x="14" y="98" width="128" height="4" rx="2" />
      <rect class="af" x="14" y="98" width="78" height="4" rx="2" />
      <circle class="af" cx="92" cy="100" r="6" />
      <g transform="translate(160 22)">
        <circle class="af" cx="8" cy="8" r="7" /><path class="ck" d="M4.5 8l2.5 2.5 4.5-5" />
        <rect class="mf" x="22" y="5" width="44" height="6" rx="3" />
        <circle class="af" cx="8" cy="36" r="7" /><path class="ck" d="M4.5 36l2.5 2.5 4.5-5" />
        <rect class="mf" x="22" y="33" width="36" height="6" rx="3" />
        <circle class="a" cx="8" cy="64" r="7" /><path class="af" d="M6 60.5l5 3.5-5 3.5z" />
        <rect class="mf" x="22" y="61" width="40" height="6" rx="3" />
      </g>
    </g>
  )}

  {art === "focus" && (
    <g>
      <rect class="card o6" x="44" y="10" width="120" height="80" rx="4" />
      <rect class="card o8" x="54" y="18" width="120" height="80" rx="4" />
      <rect class="card" x="64" y="26" width="120" height="80" rx="4" />
      <rect class="af o2" x="76" y="38" width="46" height="14" rx="7" />
      <text class="t ta" x="99" y="48.5" text-anchor="middle">PHYSICS</text>
      <rect class="mf" x="76" y="62" width="94" height="6" rx="3" />
      <rect class="mf" x="76" y="74" width="70" height="6" rx="3" />
      <circle class="a" cx="196" cy="30" r="16" />
      <circle class="a" cx="196" cy="30" r="7" />
      <path class="a" d="M196 8v10M196 42v10M174 30h10M208 30h10" />
    </g>
  )}

  {art === "complement" && (
    <g>
      <rect class="card" x="12" y="28" width="90" height="64" rx="4" />
      <text class="t" x="24" y="46">LESSON</text>
      <text class="t" x="24" y="58">QUIZ</text>
      <circle class="af" cx="30" cy="76" r="4" /><circle class="m" cx="44" cy="76" r="4" /><circle class="m" cx="58" cy="76" r="4" />
      <circle class="a" cx="120" cy="60" r="10" />
      <path class="a" d="M115 60h10M120 55v10" />
      <rect class="card" x="138" y="22" width="90" height="76" rx="4" />
      <rect class="card" x="144" y="28" width="90" height="76" rx="4" />
      <text class="t ta" x="156" y="46">QUESTION</text>
      <text class="t ta" x="156" y="58">BANK</text>
      <rect class="mf" x="156" y="70" width="60" height="5" rx="2.5" />
      <rect class="mf" x="156" y="81" width="44" height="5" rx="2.5" />
    </g>
  )}

  {art === "access" && (
    <g>
      <rect class="card" x="22" y="38" width="44" height="44" rx="4" />
      <rect class="af o4" x="32" y="48" width="24" height="24" rx="2" />
      <text class="t tm" x="44" y="100" text-anchor="middle">ON ITS OWN</text>
      <text class="t tm" x="96" y="64" text-anchor="middle">OR</text>
      <rect class="card" x="126" y="14" width="92" height="76" rx="4" />
      {Array.from({ length: 9 }, (_, i) => (
        <rect class:list={[i === 8 ? "af" : "mf"]} x={134 + (i % 3) * 26} y={22 + Math.floor(i / 3) * 21} width="22" height="16" rx="2" />
      ))}
      <text class="t tm" x="172" y="106" text-anchor="middle">IN THE BUNDLE</text>
    </g>
  )}

  {art === "subjects" && (
    <g>
      {subjects.map((s, i) => (
        <g transform={`translate(${16 + (i % 4) * 54} ${18 + Math.floor(i / 4) * 46})`}>
          <rect class="card" width="46" height="38" rx="4" />
          <rect class="af" width="46" height="3" />
          <text class="t ts" x="23" y="25" text-anchor="middle">{s}</text>
        </g>
      ))}
    </g>
  )}

  {art === "connect" && (
    <g>
      <rect class="card" x="14" y="24" width="86" height="64" rx="4" />
      <path class="af" d="M50 44l16 12-16 12z" />
      <text class="t tm" x="57" y="104" text-anchor="middle">COURSEWORK</text>
      <path class="a" d="M110 56h28" />
      <path class="a" d="M132 50l7 6-7 6" />
      <rect class="card" x="148" y="24" width="80" height="64" rx="4" />
      <circle class="m" cx="162" cy="42" r="4" /><rect class="mf" x="172" y="39" width="44" height="6" rx="3" />
      <circle class="af" cx="162" cy="56" r="4" /><rect class="af o4" x="172" y="53" width="44" height="6" rx="3" />
      <circle class="m" cx="162" cy="70" r="4" /><rect class="mf" x="172" y="67" width="34" height="6" rx="3" />
      <text class="t tm" x="188" y="104" text-anchor="middle">REVIEW</text>
    </g>
  )}

  {art === "week" && (
    <g>
      {["M", "T", "W", "T", "F", "S", "S"].map((d, i) => (
        <g transform={`translate(${14 + i * 31} 14)`}>
          <text class="t tm" x="13" y="8" text-anchor="middle">{d}</text>
          <rect class="card" y="16" width="26" height="80" rx="3" />
        </g>
      ))}
      <rect class="af" x="18" y="74" width="18" height="12" rx="2" />
      <rect class="af o6" x="80" y="38" width="18" height="12" rx="2" />
      <rect class="af" x="111" y="88" width="18" height="12" rx="2" />
      <rect class="af o6" x="173" y="50" width="18" height="12" rx="2" />
      <rect class="af" x="204" y="62" width="18" height="12" rx="2" />
    </g>
  )}

  {art === "progress" && (
    <g>
      {[0.85, 0.6, 0.72, 0.4].map((w, i) => (
        <g transform={`translate(14 ${16 + i * 24})`}>
          <circle class="m" cx="8" cy="7" r="7" />
          <rect class="m" x="24" y="3" width="188" height="8" rx="4" />
          <rect class:list={["af", i % 2 && "o6"]} x="24" y="3" width={188 * w} height="8" rx="4" />
        </g>
      ))}
      <text class="t tm" x="38" y="114">ILLUSTRATIVE</text>
    </g>
  )}

  {art === "coordinate" && (
    <g>
      <rect class="card" x="14" y="14" width="140" height="92" rx="4" />
      <rect class="af" x="14" y="14" width="140" height="14" rx="4" />
      {Array.from({ length: 15 }, (_, i) => (
        <rect class:list={[i === 3 || i === 11 ? "af" : "mf"]} x={24 + (i % 5) * 25} y={38 + Math.floor(i / 5) * 22} width="20" height="14" rx="2" />
      ))}
      <rect class="card" x="168" y="40" width="58" height="40" rx="3" />
      <path class="a" d="M168 42l29 20 29-20" />
      <circle class="af" cx="222" cy="40" r="8" />
      <path class="ck" d="M218.5 40l2.5 2.5 4.5-5" />
    </g>
  )}
</svg>

<style>
  .fa { display: block; width: 100%; height: auto; max-height: 8.5rem; }
  .fa .a { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .fa .m { fill: none; stroke: var(--border); stroke-width: 2; }
  .fa .af { fill: var(--accent); }
  .fa .mf { fill: var(--border); }
  .fa .kf { fill: var(--mark); }
  .fa .card { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; }
  .fa .ck { fill: none; stroke: var(--accent-contrast); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .fa .t { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.06em; fill: var(--text); }
  .fa .tm { fill: var(--text-muted); font-size: 8px; }
  .fa .ta { fill: var(--accent); }
  .fa .ts { font-size: 11px; font-weight: 500; }
  .fa .o2 { opacity: 0.2; }
  .fa .o4 { opacity: 0.4; }
  .fa .o6 { opacity: 0.6; }
  .fa .o8 { opacity: 0.8; }
</style>
