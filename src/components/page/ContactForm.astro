---
// Contact and consultation form.
//
// Delivery: GitHub Pages can't run server code, so messages go to a form
// service named at build time by PUBLIC_CONTACT_ENDPOINT (any endpoint that
// accepts a form POST and answers 2xx, e.g. Formspree). The service owns
// server-side validation, rate limiting, spam filtering and delivery to the
// monitored inbox; `_gotcha` is the usual honeypot field name.
//
// Until an endpoint is configured the form does not pretend to send: it
// opens the visitor's email app with the message filled in, and says so.
import { products } from "../../content/courses";
import { footer, links } from "../../content/homepage";

const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT as string | undefined;
const email = footer.contactEmail;
const courseOptions = products.map((p) => ({ slug: p.slug, title: p.title }));
---

<form
  id="contact-form"
  class="cf"
  novalidate
  action={endpoint || `mailto:${email}`}
  method="post"
  enctype={endpoint ? undefined : "text/plain"}
  data-endpoint={endpoint || ""}
  data-email={email}
  data-thanks={links.contact + "thank-you/"}
>
  <h2 class="cf-h" id="cf-heading" data-default="Send us a message" data-program="Discuss your residency program.">Send us a message</h2>
  <p class="cf-note" data-program-only hidden>Send a request and we’ll coordinate a time by email.</p>

  <div class="cf-grid">
    <div class="cf-field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-err" />
      <p class="cf-err" id="cf-name-err" aria-live="polite"></p>
    </div>

    <div class="cf-field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" />
      <p class="cf-err" id="cf-email-err" aria-live="polite"></p>
    </div>

    <div class="cf-field cf-wide">
      <label for="cf-intent">I’m contacting you about</label>
      <select id="cf-intent" name="intent" required aria-describedby="cf-intent-err">
        <option value="">Choose one</option>
        <option value="program">Residency program</option>
        <option value="individual">Individual course or bundle</option>
        <option value="general">General question</option>
      </select>
      <p class="cf-err" id="cf-intent-err" aria-live="polite"></p>
    </div>

    <div class="cf-field cf-wide" data-individual-only hidden>
      <label for="cf-course">Course <span class="cf-opt">(optional)</span></label>
      <select id="cf-course" name="course">
        <option value="">Not sure yet</option>
        {courseOptions.map((c) => <option value={c.slug}>{c.title}</option>)}
      </select>
    </div>

    <div class="cf-field" data-program-only hidden>
      <label for="cf-org">Program or institution</label>
      <input id="cf-org" name="institution" type="text" autocomplete="organization" aria-describedby="cf-org-err" />
      <p class="cf-err" id="cf-org-err" aria-live="polite"></p>
    </div>

    <div class="cf-field">
      <label for="cf-role">Role <span class="cf-opt">(optional)</span></label>
      <input id="cf-role" name="role" type="text" autocomplete="organization-title" />
    </div>

    <div class="cf-field" data-program-only hidden>
      <label for="cf-residents">Number of residents <span class="cf-opt">(optional)</span></label>
      <input id="cf-residents" name="residents" type="text" inputmode="numeric" />
    </div>

    <div class="cf-field" data-program-only hidden>
      <label for="cf-time">Preferred timeframe <span class="cf-opt">(optional)</span></label>
      <input id="cf-time" name="timeframe" type="text" placeholder="e.g. next academic year" />
    </div>

    <div class="cf-field cf-wide">
      <label for="cf-msg">Message</label>
      <textarea id="cf-msg" name="message" rows="6" required aria-describedby="cf-msg-err"></textarea>
      <p class="cf-err" id="cf-msg-err" aria-live="polite"></p>
    </div>
  </div>

  <!-- Honeypot: hidden from people, filled in by bots. -->
  <div class="cf-hp" aria-hidden="true">
    <label for="cf-gotcha">Leave this field empty</label>
    <input id="cf-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="cf-privacy">
    We’ll use these details to respond to your inquiry. Read our <a class="text-link" href={links.privacy}>Privacy Policy</a>.
  </p>
  {!endpoint && (
    <p class="cf-privacy" id="cf-mailnote">Sending opens your email app with your message filled in, addressed to {email}.</p>
  )}

  <button type="submit" class="btn btn-primary cf-submit" data-default="Send message" data-program="Request a consult">Send message</button>
  <p class="cf-status" id="cf-status" role="status" aria-live="polite"></p>
</form>

<script is:inline type="application/json" id="cf-courses" set:html={JSON.stringify(courseOptions.map((c) => c.slug))}></script>

<style>
  .cf { border: 1px solid var(--border); background: var(--surface); padding: clamp(1.4rem, 3.5vw, 2.25rem); scroll-margin-top: 5rem; }
  .cf-h { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 2.4vw, 1.6rem); letter-spacing: -0.01em; }
  .cf-note { margin: 0.6rem 0 0; color: var(--text-muted); }
  .cf-grid { display: grid; gap: 1.1rem 1.25rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .cf-grid { grid-template-columns: 1fr 1fr; } .cf-wide { grid-column: 1 / -1; } }
  .cf-field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .cf-field[hidden] { display: none; }
  .cf label { font-size: 0.92rem; font-weight: 500; }
  .cf-opt { color: var(--text-muted); font-weight: 400; }

  .cf input, .cf select, .cf textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
  }
  .cf textarea { resize: vertical; min-height: 8rem; }
  .cf input:focus-visible, .cf select:focus-visible, .cf textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .cf [aria-invalid="true"] { border-color: #c2410c; }
  .cf-err { margin: 0; min-height: 0; font-size: 0.88rem; color: #c2410c; }
  :root.dark .cf-err { color: #fb923c; }
  :root.dark .cf [aria-invalid="true"] { border-color: #fb923c; }

  .cf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cf-privacy { margin: 1.25rem 0 0; font-size: 0.9rem; color: var(--text-muted); }
  .cf-privacy + .cf-privacy { margin-top: 0.4rem; }
  .cf-submit { margin-top: 1.4rem; }
  .cf-submit[disabled] { opacity: 0.7; cursor: progress; }
  .cf-status { margin: 1rem 0 0; font-size: 0.95rem; }
  .cf-status.is-error { color: #c2410c; }
  :root.dark .cf-status.is-error { color: #fb923c; }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form) {
    const endpoint = form.dataset.endpoint || "";
    const email = form.dataset.email || "";
    const status = document.getElementById("cf-status")!;
    const submit = form.querySelector<HTMLButtonElement>(".cf-submit")!;
    const heading = document.getElementById("cf-heading")!;
    const intent = form.elements.namedItem("intent") as HTMLSelectElement;
    const course = form.elements.namedItem("course") as HTMLSelectElement;
    const org = form.elements.namedItem("institution") as HTMLInputElement;
    const known = JSON.parse(document.getElementById("cf-courses")?.textContent || "[]") as string[];

    // Prefill from the link that brought the visitor here (whitelisted).
    const params = new URLSearchParams(location.search);
    const wanted = params.get("intent");
    if (wanted && ["program", "individual", "general"].includes(wanted)) intent.value = wanted;
    const wantedCourse = params.get("course");
    if (wantedCourse && known.includes(wantedCourse)) {
      intent.value = intent.value || "individual";
      course.value = wantedCourse;
    }

    function applyIntent() {
      const v = intent.value;
      form!.querySelectorAll<HTMLElement>("[data-program-only]").forEach((el) => (el.hidden = v !== "program"));
      form!.querySelectorAll<HTMLElement>("[data-individual-only]").forEach((el) => (el.hidden = v !== "individual"));
      org.required = v === "program";
      heading.textContent = v === "program" ? heading.dataset.program! : heading.dataset.default!;
      submit.textContent = v === "program" ? submit.dataset.program! : submit.dataset.default!;
    }
    intent.addEventListener("change", applyIntent);
    applyIntent();

    const emailOk = (s: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);

    function setError(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, msg: string) {
      const err = document.getElementById(field.getAttribute("aria-describedby") || "");
      field.setAttribute("aria-invalid", msg ? "true" : "false");
      if (err) err.textContent = msg;
    }

    function validate() {
      let first: HTMLElement | null = null;
      const fields = form!.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]");
      fields.forEach((f) => {
        const value = f.value.trim();
        let msg = "";
        if (!value) msg = "Please complete this field";
        else if (f.type === "email" && !emailOk(value)) msg = "Enter a valid email address";
        setError(f, msg);
        if (msg && !first) first = f;
      });
      // Clear stale errors on fields no longer required (e.g. intent changed).
      if (!org.required) setError(org, "");
      return first as HTMLElement | null;
    }

    form.querySelectorAll("input, select, textarea").forEach((f) =>
      f.addEventListener("blur", () => {
        const el = f as HTMLInputElement;
        if (el.getAttribute("aria-invalid") === "true") validate();
      }),
    );

    const intentLabel: Record<string, string> = {
      program: "Residency program consult request",
      individual: "Course or bundle inquiry",
      general: "General question",
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.textContent = "";
      status.classList.remove("is-error");

      const invalid = validate();
      if (invalid) {
        invalid.focus();
        status.textContent = "Please check the highlighted fields.";
        status.classList.add("is-error");
        return;
      }

      const data = new FormData(form);
      if (String(data.get("_gotcha") || "")) return; // bot

      const courseTitle = course.value ? course.options[course.selectedIndex].text : "";
      if (courseTitle) data.set("course", courseTitle);
      data.set("_subject", `${intentLabel[intent.value]} · ${data.get("name")}`);

      if (!endpoint) {
        // No delivery service configured: hand the message to the email app.
        const line = (label: string, key: string) => {
          const v = String(data.get(key) || "").trim();
          return v ? [`${label}: ${v}`] : [];
        };
        const lines = [
          ...line("Name", "name"),
          ...line("Email", "email"),
          `About: ${intent.options[intent.selectedIndex].text}`,
          ...line("Course", "course"),
          ...line("Program or institution", "institution"),
          ...line("Role", "role"),
          ...line("Number of residents", "residents"),
          ...line("Preferred timeframe", "timeframe"),
          "",
          String(data.get("message")),
        ];
        const href = `mailto:${email}?subject=${encodeURIComponent(String(data.get("_subject")))}&body=${encodeURIComponent(lines.join("\n"))}`;
        location.href = href;
        status.textContent = `Your email app should open with your message ready to send. If it doesn’t, email ${email}.`;
        return;
      }

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = "Sending…";
      status.textContent = "Sending…";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        // Genuine acceptance only. No personal data in the URL.
        location.assign(`${form.dataset.thanks}${intent.value === "program" ? "?type=program" : ""}`);
      } catch {
        status.textContent = `Your message could not be sent. Please try again or email ${email}.`;
        status.classList.add("is-error");
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
