---
// Quick look at a product as a native <dialog>: focus trapping, Esc-to-close
// and the backdrop come free. Opened by the matching card via data-open.
// The product page is the permanent home; this links to it.
import CourseVignette from "./CourseVignette.astro";
import type { Course, QuestionBank } from "../content/courses";
import { enrollInquiryHref, productHref, productLabel } from "../content/courses";
import { instructors } from "../content/team";

interface Props {
  course: Course | QuestionBank;
}
const { course } = Astro.props;
const isCourse = course.kind === "course";
const taught = isCourse ? course.instructors.map((id) => instructors[id].name) : [];
---

<dialog class="cm" id={`cm-${course.slug}`} aria-labelledby={`cm-title-${course.slug}`}>
  <div class="cm-panel">
    <button type="button" class="cm-close" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>

    <div class="cm-hero">
      {isCourse ? <img src={course.image} alt="" width="438" height="304" /> : <CourseVignette kind="board-review" />}
      <div class="cm-hero-text">
        <span class="tag-mono cm-meta">{productLabel[course.kind].toUpperCase()}</span>
        <h3 class="cm-title" id={`cm-title-${course.slug}`}>{course.title}</h3>
      </div>
    </div>

    <div class="cm-body">
      <div class="cm-main">
        {taught.length > 0 && <p class="tag-mono cm-taught">TAUGHT BY {taught.join(" · ").toUpperCase()}</p>}
        <p class="cm-p">{course.hero}</p>
        {isCourse ? (
          <>
            <h4 class="cm-h">What you’ll learn</h4>
            <ul class="cm-list">{course.outcomes.map((l) => <li>{l}</li>)}</ul>
          </>
        ) : (
          <p class="cm-p">Covers radiology physics. Clinical exam content is not included. Included in the Radiology Physics Course Bundle.</p>
        )}
      </div>

      {isCourse && (
        <aside class="cm-side">
          <h4 class="cm-h cm-h-first">Topics covered</h4>
          <ul class="cm-topics">
            {course.topics.map((t) => <li>{t}</li>)}
          </ul>
        </aside>
      )}
    </div>

    <div class="cm-actions">
      <a href={productHref(course)} class="btn btn-primary">{isCourse ? "View course" : "View details"}</a>
      <a href={enrollInquiryHref(course)} class="btn btn-ghost">Ask about enrollment</a>
    </div>
  </div>
</dialog>

<style>
  .cm {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(60rem, calc(100vw - 2rem));
    max-height: min(92vh, calc(100vh - 2rem));
    width: 100%;
    margin: auto;
    overflow: visible;
    opacity: 0;
    transform: translateY(14px) scale(0.985);
    transition: opacity 0.28s ease, transform 0.32s cubic-bezier(0.22, 0.9, 0.28, 1), overlay 0.32s allow-discrete, display 0.32s allow-discrete;
  }

  .cm[open] { opacity: 1; transform: none; }

  @starting-style {
    .cm[open] { opacity: 0; transform: translateY(14px) scale(0.985); }
  }

  .cm::backdrop {
    background: rgba(3, 20, 43, 0.62);
    backdrop-filter: blur(6px);
    transition: opacity 0.3s ease;
  }

  .cm-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: min(92vh, calc(100vh - 2rem));
    overflow: auto;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    overscroll-behavior: contain;
  }

  .cm-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(3, 20, 43, 0.55);
    color: #ffffff;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .cm-close:hover { background: rgba(3, 20, 43, 0.85); transform: rotate(90deg); }
  .cm-close svg { width: 1rem; height: 1rem; }

  .cm-hero {
    position: relative;
    aspect-ratio: 16 / 6;
    min-height: 12rem;
    overflow: hidden;
    background: #04070c;
    flex-shrink: 0;
  }

  .cm-hero img,
  .cm-hero :global(.cv) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }

  .cm-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(3, 20, 43, 0.92) 0%, rgba(3, 20, 43, 0.35) 55%, rgba(2, 43, 98, 0.25) 100%);
  }

  .cm-hero-text {
    position: absolute;
    left: clamp(1.25rem, 4vw, 2.25rem);
    right: 4rem;
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 1;
    color: #ffffff;
  }

  .cm-meta { color: #7fd3dc; display: block; margin-bottom: 0.5rem; }

  .cm-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
  }

  .cm-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }

  @media (min-width: 820px) {
    .cm-body { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr); gap: 3rem; }
  }

  .cm-p { margin: 0 0 1rem; color: var(--text-muted); line-height: 1.7; font-size: 0.97rem; }
  .cm-taught { display: block; margin: 0 0 1rem; color: var(--accent); }

  .cm-h {
    margin: 1.75rem 0 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .cm-h-first { margin-top: 0; }

  .cm-list { margin: 0; padding-left: 1.15rem; color: var(--text-muted); line-height: 1.65; font-size: 0.95rem; }
  .cm-list li { margin-bottom: 0.35rem; }
  .cm-list li::marker { color: var(--accent); }


  .cm-topics { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .cm-topics li { padding: 0.7rem 0; border-bottom: 1px solid var(--border); font-size: 0.95rem; line-height: 1.45; }

  .cm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0 clamp(1.25rem, 4vw, 2.25rem) clamp(1.25rem, 4vw, 2rem);
  }

  /* Phones: a full-height sheet rising from the bottom. */
  @media (max-width: 640px) {
    .cm {
      max-width: 100vw;
      max-height: 100vh;
      height: 100vh;
      margin: 0;
      transform: translateY(24px);
    }
    .cm-panel { max-height: 100vh; height: 100vh; border: 0; }
    .cm-hero { aspect-ratio: auto; height: 14rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm, .cm::backdrop { transition: none; }
  }
</style>
