---
// Catalogue card with a permanent link to the product page (the quick-preview
// dialog on the homepage is an extra, never the only way to read a course).
import CourseVignette from "./CourseVignette.astro";
import type { Product } from "../content/courses";
import { productHref } from "../content/courses";

interface Props {
  course: Product;
}
const { course } = Astro.props;
const cta = course.kind === "course" ? "View course" : "View details";
---

<article class="card bracket-frame lift">
  <span class="bf-corner" aria-hidden="true"></span>
  <span class="bf-corner" aria-hidden="true"></span>
  <div class="inner">
    <div class:list={["media", course.image && "has-photo"]}>
      {course.image
        ? <img src={course.image} alt="" loading="lazy" width="438" height="304" />
        : <CourseVignette kind={course.vignette} light />}
      <span class="tag-mono media-tag">{course.tag.toUpperCase()}</span>
    </div>
    <div class="body">
      <div>
        <h3><a href={productHref(course)}>{course.title}</a></h3>
        <p>{course.summary}</p>
      </div>
      <a class="link-accent" href={productHref(course)} aria-label={`${cta}: ${course.title}`}>{cta}</a>
    </div>
  </div>
</article>

<style>
  .inner { position: relative; display: flex; height: 100%; flex-direction: column; background: var(--surface); }
  .media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--border); }
  .media.has-photo { background: #04070c; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.9) contrast(1.05); }
  .media.has-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(2, 43, 98, 0.35), transparent 45%), linear-gradient(to top, rgba(3, 20, 43, 0.55), transparent 55%);
  }
  .media-tag { position: absolute; top: 0.75rem; left: 0.85rem; z-index: 1; color: #e6eef3; }
  .media:not(.has-photo) .media-tag { color: var(--text-muted); }
  :global(:root.dark) .media:not(.has-photo) .media-tag { color: #e6eef3; }
  .body { display: flex; flex: 1; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding: 1.5rem; }
  h3 { margin: 0; font-size: 1.0rem; font-weight: 600; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p { margin: 0.5rem 0 0; color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; }
  .link-accent { align-self: flex-start; }
</style>
