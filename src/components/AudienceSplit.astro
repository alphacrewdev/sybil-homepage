---
import { audiences } from "../content/homepage";
---

<section class="mx-auto max-w-6xl px-5 py-20 md:px-8">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-6">
    {audiences.map((a) => (
      <div class="flex flex-col justify-between border p-7" style="border-color: var(--border);">
        <div>
          <h3 class="font-[family-name:var(--font-display)] text-xl font-semibold tracking-tight">{a.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{a.body}</p>
        </div>
        <a
          href={a.cta.href}
          class="mt-7 inline-block w-fit border-b text-sm font-medium transition-colors hover:text-[var(--accent)]"
          style="border-color: var(--accent);"
        >
          {a.cta.label}
        </a>
      </div>
    ))}
  </div>
</section>
