---
// Analytics + the opt-in cookie card. Renders NOTHING unless the build sets a valid PUBLIC_GTM_CONTAINER_ID
// (GTM-XXXXXXX) or PUBLIC_GA_MEASUREMENT_ID (G-XXXXXXX); GTM wins when both are set, so only one ever loads.
// No Google script is requested until the visitor clicks Accept.
// Logic: src/lib/analytics/{consent,controller,gtm,ga4}.ts. Activation: docs/GTM-ACTIVATION-CHECKLIST.md.
import { analyticsSetup } from "../lib/analytics/setup";
import { bannerCopy } from "../lib/analytics/consent";
import { sanitizePath } from "../lib/analytics/ga4";
import { links } from "../content/homepage";

interface Props {
  /** The page's static, public title. */
  title: string;
}

const setup = analyticsSetup;
// The route path as built — never the visitor's live URL, query string or hash (used by the direct GA4 path).
const config = setup
  ? JSON.stringify({ ...setup, path: sanitizePath(Astro.url.pathname), title: Astro.props.title }).replace(/</g, "\\u003c")
  : null;
const copy = setup ? bannerCopy(setup.provider) : null;
---

{config && copy && (
  <>
    <script type="application/json" id="analytics-config" set:html={config} />
    <section class="consent" id="cookie-consent" aria-labelledby="cookie-consent-title" hidden>
      <h2 id="cookie-consent-title">{copy.title}</h2>
      <p>
        {copy.body} <a href={links.privacy}>Privacy policy</a>
      </p>
      <div class="choices">
        <button type="button" data-consent="decline">Decline</button>
        <button type="button" data-consent="accept">Accept</button>
      </div>
    </section>
    <script>
      import { createConsentController } from "../lib/analytics/controller";
      import type { AnalyticsDocument, AnalyticsWindow } from "../lib/analytics/ga4";

      try {
        const raw = document.getElementById("analytics-config")?.textContent;
        const card = document.getElementById("cookie-consent");
        if (raw && card) {
          const { provider, id, path, title } = JSON.parse(raw);
          let storage: Storage | null = null;
          try {
            storage = window.localStorage;
          } catch {
            // Blocked storage: no remembered choice, the card asks on every page.
          }
          const controller = createConsentController({
            setup: { provider, id },
            page: { path, title },
            win: window as unknown as AnalyticsWindow,
            doc: document as unknown as AnalyticsDocument & { cookie: string },
            storage,
            hostname: window.location.hostname,
            banner: {
              show: () => {
                card.hidden = false;
              },
              hide: () => {
                card.hidden = true;
              },
            },
          });
          card.querySelector('[data-consent="accept"]')?.addEventListener("click", () => controller.accept());
          card.querySelector('[data-consent="decline"]')?.addEventListener("click", () => controller.decline());
          // "Cookie settings" in the footer reopens the card.
          document.addEventListener("click", (event) => {
            const target = event.target as Element | null;
            if (target?.closest?.("[data-cookie-settings]")) {
              controller.reopen();
              card.querySelector<HTMLButtonElement>('[data-consent="accept"]')?.focus();
            }
          });
        }
      } catch {
        // Analytics must never affect the page.
      }
    </script>
  </>
)}

<style>
  /* The SDL platform's consent card (bottom-right on desktop, inset on phones), in the site's tokens.
     Non-modal, no close button, Accept and Decline carry equal weight. */
  .consent {
    position: fixed;
    z-index: 55;
    left: max(0.75rem, env(safe-area-inset-left, 0px));
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    box-shadow: 0 14px 34px rgb(2 20 43 / 0.22);
  }
  .consent[hidden] { display: none; }
  @media (min-width: 640px) {
    .consent { left: auto; right: 1.5rem; bottom: 1.5rem; width: 23.75rem; padding: 1.25rem; }
  }
  .consent h2 { margin: 0; font-family: var(--font-display); font-size: 0.95rem; font-weight: 600; line-height: 1.3; }
  .consent p { margin: 0; font-size: 0.875rem; line-height: 1.6; color: var(--text-muted); }
  .consent a { color: var(--accent); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; }
  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem; }
  .choices button {
    min-height: 2.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: 600 0.875rem var(--font-body);
    cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .choices button:hover { background: var(--bg); }
  .choices button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
