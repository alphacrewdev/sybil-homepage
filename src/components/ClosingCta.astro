---
import { closing } from "../content/homepage";
import { withBase } from "../lib/base";
---

<section class="cta-band" id="cta-band">
  <img src={withBase("/brand/sybil-mark-white.png")} alt="" class="watermark" id="cta-mark" aria-hidden="true" />
  <div class="wrap section rv">
    <h2 class="section-title title">{closing.heading}</h2>
    <p class="section-lede lede">{closing.body}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={closing.primary.href} class="btn btn-light">{closing.primary.label}</a>
      <a href={closing.secondary.href} class="btn btn-outline">{closing.secondary.label}</a>
    </div>
  </div>
</section>

<style>
  /* Always the logo's navy-to-teal ramp, in both themes — this is the one
     place the brand gradient is used as a surface rather than a hairline. */
  .cta-band {
    position: relative;
    overflow: hidden;
    background: linear-gradient(115deg, var(--color-navy-900) 0%, var(--color-navy-700) 40%, var(--color-teal-500) 100%);
    color: #ffffff;
  }

  .watermark {
    position: absolute;
    right: -6%;
    top: 50%;
    width: clamp(18rem, 44vw, 36rem);
    max-width: none;
    transform: translateY(-50%) rotate(-8deg);
    opacity: 0.13;
    pointer-events: none;
  }

  .title { color: #ffffff; }
  .lede { color: rgba(255, 255, 255, 0.82); }

  .btn-light {
    background: #ffffff;
    color: var(--color-navy-700);
  }

  .btn-light:hover { filter: brightness(0.97); }

  .btn-outline {
    border-color: rgba(255, 255, 255, 0.55);
    color: #ffffff;
  }

  .btn-outline:hover { border-color: #ffffff; }

  .wrap { position: relative; }
</style>

<script>
  // The mark drifts slowly against the scroll, so the band has depth.
  const band = document.getElementById("cta-band");
  const mark = document.getElementById("cta-mark");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (band && mark && !reduced) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = band.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      const p = (window.innerHeight - r.top) / (window.innerHeight + r.height);
      mark.style.transform = `translateY(calc(-50% + ${(p - 0.5) * -80}px)) rotate(${-8 + (p - 0.5) * 6}deg)`;
    };
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
