---
// "Behind the image": a scroll-driven illustrative animation, from a bone
// scan to the gamma camera that records one, under two audience messages. The 3D runtime (three.js) is loaded
// only when the section approaches, WebGL works and motion is allowed;
// otherwise the section shows rendered stills with the same copy.
//
// Content: src/content/behindImage.ts
// Scene configuration: src/scripts/behind-image/config.ts
// Geometry and materials: src/scripts/behind-image/scene.ts
// Runtime (scroll, camera, labels): src/scripts/behind-image/index.ts
// Science notes and review flags: docs/behind-the-image.md
import { behindImage as c } from "../content/behindImage";
import { withBase } from "../lib/base";

const posterA = withBase("/images/behind-image/scene-a.jpg");
const posterB = withBase("/images/behind-image/scene-b.jpg");
const posterAMobile = withBase("/images/behind-image/scene-a-mobile.jpg");
const posterBMobile = withBase("/images/behind-image/scene-b-mobile.jpg");
---

<section class="bi band-dark" id="behind-the-image" aria-labelledby="bi-heading">
  <h2 id="bi-heading" class="sr-only">{c.beats[0].headline}</h2>
  <p class="sr-only">{c.beats[0].body} {c.beats[1].headline} {c.beats[1].body} {c.description}</p>

  <div class="bi-sticky">
    <picture class="bi-poster" aria-hidden="true">
      <source media="(max-width: 899px)" srcset={posterAMobile} />
      <img src={posterA} alt="" width="1600" height="1000" decoding="async" />
    </picture>
    <canvas class="bi-canvas" aria-hidden="true"></canvas>

    <div class="bi-copy" aria-hidden="true">
      {c.beats.map((b, i) => (
        <div class="bi-beat" data-beat={i}>
          <span class="eyebrow">{b.kicker}</span>
          <p class="bi-headline">{b.headline}</p>
          <p class="bi-sub">{b.body}</p>
        </div>
      ))}
    </div>

    <p class="bi-caption tag-mono" aria-hidden="true"><span>{c.caption}</span><span>{c.note}</span></p>
  </div>

  <!-- Static version: reduced motion, no WebGL, or the scene failed to load. -->
  <div class="bi-static wrap">
    <div class="bi-static-grid">
      {c.beats.map((b, i) => (
        <figure class="bi-static-fig">
          <picture>
            <source media="(max-width: 899px)" srcset={i === 0 ? posterAMobile : posterBMobile} />
            <img src={i === 0 ? posterA : posterB} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
          </picture>
          <figcaption>
            <span class="eyebrow">{b.kicker}</span>
            <span class="bi-headline">{b.headline}</span>
            <span class="bi-sub">{b.body}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="tag-mono">{c.caption} · {c.note}</p>
  </div>
</section>

<style>
  .bi {
    position: relative;
    height: 240vh;
    height: 240svh;
    background: var(--color-ink-950);
  }

  .bi-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .bi-canvas,
  .bi-poster,
  .bi-poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bi-poster img { object-fit: cover; }
  /* Once the live scene has drawn, the poster goes so the two never overlap. */
  .bi[data-ready] .bi-poster { visibility: hidden; }
  .bi-canvas { opacity: 0; transition: opacity 0.6s ease; }
  .bi.bi-live .bi-canvas { opacity: 1; }

  /* Scrim under the copy column only, so the scene stays clean elsewhere. */
  .bi-sticky::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-ink-950) 94%, transparent) 0%, color-mix(in srgb, var(--color-ink-950) 80%, transparent) 34%, transparent 56%);
  }

  .bi-copy {
    position: absolute;
    z-index: 2;
    left: max(clamp(1.05rem, 4vw, 2rem), calc((100vw - 72rem) / 2 + 2rem));
    top: 50%;
    transform: translateY(-50%);
    width: min(27rem, 40vw);
    display: grid;
  }

  .bi-beat {
    grid-area: 1 / 1;
    align-self: center;
    opacity: 0;
    visibility: hidden;
  }

  /* Before the runtime takes over (and without JavaScript), show the first message. */
  .bi:not(.bi-live) .bi-beat[data-beat="0"] { opacity: 1; visibility: visible; }

  .bi-headline {
    display: block;
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    font-size: clamp(2rem, 3.3vw, 3.1rem);
    text-wrap: balance;
  }

  .bi-sub {
    display: block;
    margin: 1.1rem 0 0;
    color: #c9d6de;
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 30rem;
  }

  /* Under the copy column, clear of the scene. */
  .bi-caption {
    position: absolute;
    z-index: 2;
    left: max(clamp(1.05rem, 4vw, 2rem), calc((100vw - 72rem) / 2 + 2rem));
    bottom: clamp(1rem, 3vh, 2rem);
    margin: 0;
    display: grid;
    gap: 0.25rem;
    color: var(--text-muted);
  }

  .bi-static { display: none; }

  @media (max-width: 899px) {
    .bi-sticky::after {
      background: linear-gradient(0deg, color-mix(in srgb, var(--color-ink-950) 92%, transparent) 0%, color-mix(in srgb, var(--color-ink-950) 60%, transparent) 30%, transparent 52%);
    }
    .bi-copy {
      top: auto;
      bottom: clamp(1.5rem, 6vh, 3rem);
      transform: none;
      width: auto;
      right: clamp(1.05rem, 4vw, 2rem);
    }
    .bi-headline { font-size: clamp(1.7rem, 7.4vw, 2.2rem); }
    .bi-sub { font-size: 1rem; }
    .bi-caption {
      top: 4.6rem;
      bottom: auto;
      left: clamp(1.05rem, 4vw, 2rem);
      font-size: 0.62rem;
      padding: 0.35rem 0.5rem;
      color: #c9d6de;
      background: color-mix(in srgb, var(--color-ink-950) 78%, transparent);
    }
  }

  /* Static fallback: one viewport of copy plus the two key stills. */
  .bi.bi-static-mode { height: auto; }
  .bi.bi-static-mode .bi-sticky { display: none; }
  .bi.bi-static-mode .bi-static { display: block; padding-block: clamp(4rem, 9vw, 7rem); }
  .bi-static-grid {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0 1rem;
  }
  @media (min-width: 900px) { .bi-static-grid { grid-template-columns: 1fr 1fr; } }
  .bi-static-fig { margin: 0; }
  .bi-static-fig img { width: 100%; height: auto; display: block; }
  .bi-static-fig figcaption { display: grid; gap: 0.4rem; margin-top: 1rem; }
  .bi-static-fig .bi-headline { font-size: clamp(1.5rem, 2.4vw, 2rem); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".bi");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const probe = document.createElement("canvas");
    const gl = probe.getContext("webgl2") || probe.getContext("webgl");
    if (reduced || !gl) {
      root.classList.add("bi-static-mode");
    } else {
      // Fetch three.js only as the section approaches.
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          import("../scripts/behind-image/index")
            .then((m) => m.start(root))
            .catch(() => root.classList.add("bi-static-mode"));
        },
        { rootMargin: "150% 0px" },
      );
      io.observe(root);
    }
  }
</script>
